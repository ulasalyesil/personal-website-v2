{
  "$description": "Brand Layers token source. Primitives are OKLCH ramps named by hue. Brands map roles to ramps. Sentiments pick a ramp, from the brand or from a shared status hue. Global tokens pick a step per mode and, for interactive tokens, per state. Components read global tokens only.",
  "primitives": {
    "steps": {
      "50": { "l": 0.975, "c": 0.1 },
      "100": { "l": 0.95, "c": 0.18 },
      "200": { "l": 0.9, "c": 0.36 },
      "300": { "l": 0.83, "c": 0.6 },
      "400": { "l": 0.74, "c": 0.82 },
      "500": { "l": 0.64, "c": 1 },
      "600": { "l": 0.52, "c": 0.96 },
      "700": { "l": 0.47, "c": 0.86 },
      "800": { "l": 0.4, "c": 0.74 },
      "900": { "l": 0.3, "c": 0.58 },
      "950": { "l": 0.22, "c": 0.44 }
    },
    "hues": {
      "violet": { "h": 292, "c": 0.2 },
      "teal": { "h": 195, "c": 0.13 },
      "magenta": { "h": 345, "c": 0.21 },
      "red": { "h": 27, "c": 0.21 },
      "amber": { "h": 75, "c": 0.17 },
      "green": { "h": 150, "c": 0.16 },
      "violet-gray": { "h": 292, "c": 0.025 },
      "teal-gray": { "h": 195, "c": 0.02 },
      "magenta-gray": { "h": 345, "c": 0.022 },
      "gray": { "h": 0, "c": 0 }
    }
  },
  "brand": {
    "a": { "name": "Brand A", "accent": "violet", "neutral": "violet-gray" },
    "b": { "name": "Brand B", "accent": "teal", "neutral": "teal-gray" },
    "c": { "name": "Brand C", "accent": "magenta", "neutral": "magenta-gray" }
  },
  "sentiment": {
    "proposition": { "ramp": "{brand.accent}" },
    "neutral": { "ramp": "{brand.neutral}" },
    "success": { "ramp": "green" },
    "warning": { "ramp": "amber" },
    "alert": { "ramp": "red" }
  },
  "global": {
    "background/page": {
      "light": { "ramp": "{brand.neutral}", "step": 50 },
      "dark": { "ramp": "{brand.neutral}", "step": 950 }
    },
    "background/surface": {
      "light": { "step": 100 },
      "dark": { "step": 900 }
    },
    "content/primary": {
      "light": { "step": 900 },
      "dark": { "step": 50 }
    },
    "content/link": {
      "light": { "step": 800 },
      "dark": { "step": 200 }
    },
    "icon/emphasis": {
      "light": { "step": 700 },
      "dark": { "step": 300 }
    },
    "icon/on-emphasis": {
      "light": { "step": 50 },
      "dark": { "step": 950 }
    },
    "interactive/primary": {
      "light": {
        "default": { "step": 800 },
        "hover": { "step": 900 },
        "active": { "step": 950 },
        "disabled": { "ramp": "gray", "step": 200 }
      },
      "dark": {
        "default": { "step": 300 },
        "hover": { "step": 200 },
        "active": { "step": 100 },
        "disabled": { "ramp": "gray", "step": 800 }
      }
    },
    "interactive/on-primary": {
      "light": {
        "default": { "step": 50 },
        "hover": { "step": 50 },
        "active": { "step": 50 },
        "disabled": { "ramp": "gray", "step": 500 }
      },
      "dark": {
        "default": { "step": 950 },
        "hover": { "step": 950 },
        "active": { "step": 950 },
        "disabled": { "ramp": "gray", "step": 500 }
      }
    },
    "interactive/secondary": {
      "light": {
        "default": { "step": 200 },
        "hover": { "step": 300 },
        "active": { "step": 400 },
        "disabled": { "ramp": "gray", "step": 200 }
      },
      "dark": {
        "default": { "step": 800 },
        "hover": { "step": 700 },
        "active": { "step": 600 },
        "disabled": { "ramp": "gray", "step": 800 }
      }
    },
    "interactive/on-secondary": {
      "light": {
        "default": { "step": 900 },
        "hover": { "step": 900 },
        "active": { "step": 950 },
        "disabled": { "ramp": "gray", "step": 500 }
      },
      "dark": {
        "default": { "step": 50 },
        "hover": { "step": 50 },
        "active": { "step": 50 },
        "disabled": { "ramp": "gray", "step": 500 }
      }
    },
    "interactive/control": {
      "light": {
        "default": { "step": 200 },
        "hover": { "step": 300 },
        "active": { "step": 400 },
        "disabled": { "ramp": "gray", "step": 200 }
      },
      "dark": {
        "default": { "step": 800 },
        "hover": { "step": 700 },
        "active": { "step": 600 },
        "disabled": { "ramp": "gray", "step": 800 }
      }
    }
  }
}
